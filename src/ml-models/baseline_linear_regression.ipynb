# Célula 1 - Importações
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error, r2_score

# Célula 2 - Dados de exemplo (simulando dados do sensor)
dates = pd.date_range('2024-01-01', periods=100, freq='H')
temperature = np.random.normal(25, 5, 100) + np.sin(np.arange(100)*0.1)*3
humidity = np.random.normal(60, 15, 100) + np.cos(np.arange(100)*0.08)*10

df = pd.DataFrame({
    'timestamp': dates,
    'temperature': temperature,
    'humidity': humidity
})

# Célula 3 - Feature engineering
df['hour'] = df['timestamp'].dt.hour
df['day_part'] = df['hour'] // 6  # 0:madrugada, 1:manhã, 2:tarde, 3:noite

# Célula 4 - Modelo simples: prever umidade baseado na temperatura
X = df[['temperature']]
y = df['humidity']

model = LinearRegression()
model.fit(X, y)

# Célula 5 - Métricas
y_pred = model.predict(X)
mae = mean_absolute_error(y, y_pred)
r2 = r2_score(y, y_pred)

print(f"MAE: {mae:.2f}")
print(f"R²: {r2:.2f}")

# Célula 6 - Gráfico
plt.figure(figsize=(10, 6))
plt.scatter(X, y, alpha=0.6, label='Dados reais')
plt.plot(X, y_pred, color='red', linewidth=2, label='Regressão linear')
plt.xlabel('Temperatura (°C)')
plt.ylabel('Umidade (%)')
plt.legend()
plt.title('Relação Temperatura vs Umidade')
plt.show()
